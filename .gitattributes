**/scripts/*.sh text eol=lf
**/build/ci/*.sh text eol=lf
# Patches, series files and shell scripts must keep LF line endings, also on
# Windows, because "hg qpush" fails to apply the patch series when the patch
# files are checked out with CRLF line endings.
*.patch text eol=lf
series text eol=lf
series-* text eol=lf
*.sh text eol=lf
